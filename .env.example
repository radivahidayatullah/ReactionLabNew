# ============================================================
# ReactionLab 11 - Konfigurasi Lingkungan Firebase (Contoh)
# ============================================================
# CATATAN PENTING UNTUK PENGEMBANG (Vite & React):
# 1. Di Vite, seluruh variabel lingkungan yang ingin diakses di sisi peramban/frontend
#    WAJIB menggunakan awalan "VITE_".
# 2. Untuk menggunakan konfigurasi ini:
#    - Salin berkas ini dan beri nama ".env.local"
#    - Ganti nilai placeholder di bawah dengan kredensial asli dari Firebase Console Anda
#    - Jalankan ulang server lokal jika sedang berjalan: npm run dev
# 3. Berkas ".env.local" sudah terdaftar di ".gitignore" sehingga kredensial asli Anda aman
#    dan tidak akan terunggah ke repositori publik.
#
# Di mana menemukan nilai-nilai ini di Firebase Console?
# -> Buka https://console.firebase.google.com/
# -> Masuk ke Project Settings (ikon roda gigi) -> tab "General"
# -> Gulir ke bawah ke bagian "Your apps" -> pilih Web App (</>)
# -> Pilih opsi "Config" dan salin nilainya ke variabel di bawah ini.
# ============================================================

# Kunci API Web Firebase (Wajib untuk Autentikasi & Database)
VITE_FIREBASE_API_KEY=AIzaSyAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Domain Autentikasi Firebase (misal: nama-proyek-anda.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=reactionlab-11.firebaseapp.com

# ID Proyek Firebase Anda
VITE_FIREBASE_PROJECT_ID=reactionlab-11

# Bucket Penyimpanan Firebase Storage (opsional)
VITE_FIREBASE_STORAGE_BUCKET=reactionlab-11.firebasestorage.app

# ID Pengirim Pesan Cloud Messaging
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# ID Aplikasi Web Firebase
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ID Pengukuran Google Analytics (Opsional)
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

